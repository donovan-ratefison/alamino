# Without PayPal keys, payments run in simulated mode (labelled in the UI).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Without an AI key, capture and statements use a plain-code fallback.
AI_API_KEY=
AI_MODEL=
DATABASE_PATH=./data/app.db

# Finance dashboard: demo is public; Sandbox data and live AI require this password.
# Choose a separate random password of at least 16 characters. Never prefix it NEXT_PUBLIC_.
FINANCE_ADMIN_PASSWORD=
# Browser licence key for AG Studio (trial/hackathon or commercial licence).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
