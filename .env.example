# Without PayPal keys, payments run in simulated mode (labelled in the UI).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox personal account of each trader (receives the payouts).
PAYPAL_EMAIL_HERY=
PAYPAL_EMAIL_SOA=
PAYPAL_EMAIL_RIVO=
PAYPAL_EMAIL_LALAO=
PAYPAL_EMAIL_FIDY=
# AI: any OpenAI-compatible Chat Completions API. Default: Meta Model API.
# Without a key, capture and statements use a plain-code fallback.
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=
AI_MODEL=muse-spark-1.3
# Maximum AI calls per day (protects the key on a public demo).
AI_DAILY_CALLS=300
DATABASE_PATH=./data/app.db
