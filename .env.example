# Without PayPal keys, payments run in simulated mode (labelled in the UI).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox personal account of each trader (receives the payouts).
PAYPAL_EMAIL_HERY=
PAYPAL_EMAIL_SOA=
PAYPAL_EMAIL_RIVO=
PAYPAL_EMAIL_LALAO=
PAYPAL_EMAIL_FIDY=
# AI: any OpenAI-compatible Chat Completions API with images and strict structured output.
# Without a key, capture and statements use a plain-code fallback.
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=
AI_MODEL=muse-spark-1.3
# How much the model thinks before it answers: minimal, low, medium, high.
# minimal reads a notebook photo about 3 times faster, with the same result in our tests.
AI_REASONING_EFFORT=minimal
# Maximum AI calls per day (protects the key on a public demo).
AI_DAILY_CALLS=300
DATABASE_PATH=./data/app.db

# Finance dashboard: demo is public; Sandbox data and live AI require this password.
# Choose a separate random password of at least 16 characters. Never prefix it NEXT_PUBLIC_.
FINANCE_ADMIN_PASSWORD=
# Browser licence key for AG Studio (trial/hackathon or commercial licence).
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
